# Compose reads its .env from the directory of the compose file, not from the project
# root, so this file -- and not the application's .env -- feeds the ${...} substitutions
# in docker-compose.yml.
#
#   cp docker/.env.example docker/.env
#
# Without it every value below falls back to the default baked into docker-compose.yml.

# Align the container's www-data with your host user, otherwise files the containers
# write into the bind mount end up owned by uid 1000. Fill in `id -u` and `id -g`.
# Changing these after the first build needs `make -C docker rebuild`.
UID=1000
GID=1000

# MySQL creates the database and user from these on its first boot only. They must match
# DB_DATABASE / DB_USERNAME / DB_PASSWORD in the application's .env -- the app reads its
# credentials from there, MySQL is initialised from here. Changing them later requires
# dropping the volume: `make -C docker down v=1`.
DB_DATABASE=wtg
DB_USERNAME=wtg
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

# Host ports. Change any that is already taken on your machine.
APP_PORT=80
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

# The app container migrates on boot; set to false to start without touching the schema.
RUN_MIGRATIONS=true

# off | debug | develop | coverage -- Xdebug is built into the dev image but idle.
XDEBUG_MODE=off
