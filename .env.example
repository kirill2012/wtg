APP_NAME=wtg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://wtg.loc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker, compose overrides DB_HOST=mysql and REDIS_HOST=redis.
# These values are what the host machine uses to reach the published ports.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wtg
DB_USERNAME=wtg
DB_PASSWORD=secret

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
