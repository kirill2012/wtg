APP_NAME=wtg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://wtg.loc

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker, compose overrides DB_HOST=mysql.
# These values are what the host machine uses to reach the published port.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wtg
DB_USERNAME=wtg
DB_PASSWORD=secret

# ProcessImportJob pins itself to `database` regardless: an import and its job are
# written in one transaction. Leave DB_QUEUE_CONNECTION unset for the same reason: the jobs
# table must live on the application's own connection.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

