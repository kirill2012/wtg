              "path": [
                "api",
                "imports",
                "999999"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "GET /api/properties — cheapest offer per property",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "",
                  "const search = pm.response.json();",
                  "const code = pm.collectionVariables.get('propertyCode');",
                  "const row = search.data.find((r) => r.code === code);",
                  "",
                  "pm.test('the imported property is in the results', () => {",
                  "    pm.expect(row, `property ${code} not found`).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('the row has the shape of the task', () => {",
                  "    pm.expect(Object.keys(row).sort()).to.eql(['City', 'best_offer', 'code', 'name']);",
                  "    pm.expect(Object.keys(row.best_offer).sort()).to.eql([",
                  "        'available_units', 'currency', 'expires_at', 'id', 'price', 'supplier'",
                  "    ]);",
                  "    pm.expect(row.City).to.eql('Barcelona');",
                  "});",
                  "",
                  "pm.test('the cheaper of the two offers wins', () => {",
                  "    pm.expect(row.best_offer.price).to.eql(69000);",
                  "    pm.expect(row.best_offer.available_units).to.eql(1);",
                  "});",
                  "",
                  "pm.test('the property appears exactly once', () => {",
                  "    pm.expect(search.data.filter((r) => r.code === code)).to.have.lengthOf(1);",
                  "});",
                  "",
                  "pm.test('the envelope carries next, prev and per_page', () => {",
                  "    pm.expect(search.links).to.have.property('next');",
                  "    pm.expect(search.links).to.have.property('prev');",
                  "    pm.expect(search.meta).to.have.property('per_page');",
                  "});",
                  "",
                  "pm.collectionVariables.set('offerId', row.best_offer.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/properties?city=Barcelona&check_in={{checkIn}}&check_out={{checkOut}}&guests=2&per_page=100&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "Barcelona"
                },
                {
                  "key": "check_in",
                  "value": "{{checkIn}}"
                },
                {
                  "key": "check_out",
                  "value": "{{checkOut}}"
                },
                {
                  "key": "guests",
                  "value": "2"
                },
                {
                  "key": "per_page",
                  "value": "100"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "The search of the task. Two offers were imported for this property; rank 1 by price is the one that comes back, and the property appears once."
          }
        },
        {
          "name": "GET /api/properties — 422 without dates",
